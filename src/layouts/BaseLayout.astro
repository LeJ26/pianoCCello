---
import '../styles/global.css';
import { site } from '../contenu/site';

interface Props {
  titre?: string;
  description?: string;
}

const { titre = site.seo.titre, description = site.seo.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://duopianccello.fr').toString();
const ogImage = new URL(site.seo.imageOpenGraph, Astro.site ?? 'https://duopianccello.fr').toString();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{titre}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.seo.motsCles.join(', ')} />
    <link rel="canonical" href={canonical} />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.nom} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titre} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Polices Google */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Dancing+Script:wght@500;600&family=Inter:wght@300;400;500;600&family=Pinyon+Script&display=swap"
    />

    {/* Favicon + icônes + thème */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FAF7F0" />
    <meta name="color-scheme" content="light" />

    {/* JSON-LD : structure pour Google (artiste local) */}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'MusicGroup',
      name: site.nom,
      description: site.seo.description,
      genre: 'Musique de chambre',
      url: canonical,
      image: ogImage,
      sameAs: [site.contact.instagramUrl],
      member: [
        { '@type': 'Person', name: 'Claire Bournonville' },
        { '@type': 'Person', name: 'Clémentine Roques' },
      ],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Rambouillet',
        addressRegion: 'Île-de-France',
        addressCountry: 'FR',
      },
      email: site.contact.email,
      telephone: site.contact.telephoneLien,
    })} />
  </head>
  <body>
    {/* Lien d'évitement pour l'accessibilité (clavier / lecteurs d'écran) */}
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:bg-encre focus:text-ivoire focus:px-4 focus:py-2 focus:text-sm focus:font-sans"
    >Aller au contenu</a>

    {/* Barre de progression de défilement (fin trait or en haut de page) */}
    <div id="scroll-progress" class="fixed top-0 left-0 z-50 h-0.5 bg-or origin-left" style="width:100%; transform: scaleX(0)"></div>

    <slot />

    {/* Bouton retour en haut */}
    <button
      id="back-to-top"
      type="button"
      aria-label="Revenir en haut de la page"
      class="fixed bottom-6 right-6 z-40 w-12 h-12 flex items-center justify-center bg-encre text-ivoire shadow-lift opacity-0 translate-y-3 pointer-events-none transition-all duration-400 ease-soft hover:bg-or hover:-translate-y-0.5"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="w-5 h-5">
        <path d="m18 15-6-6-6 6" />
      </svg>
    </button>

    {/* Script global : défilement doux + révélations au scroll + lightbox + tracé de traits */}
    <script>
      // — Défilement doux (Lenis) : expose defilerVers / verrouillerDefilement —
      import '../scripts/defilement-doux';

      // — Révélations au scroll —
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              observer.unobserve(e.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
      );
      document.querySelectorAll('.reveal, .trait-anim').forEach((el) => observer.observe(el));

      // Précalcul de la longueur des paths SVG pour le tracé
      document.querySelectorAll('.trait-anim').forEach((svg) => {
        svg.querySelectorAll('path, line, polyline, circle').forEach((p) => {
          try {
            const len = (p as SVGGeometryElement).getTotalLength?.() ?? 1000;
            (p as SVGElement).style.setProperty('--len', String(Math.ceil(len)));
          } catch {}
        });
      });

      // — Lightbox galerie —
      const lightbox = document.getElementById('lightbox');
      const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
      const lightboxCaption = document.getElementById('lightbox-caption');
      document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((el) => {
        el.addEventListener('click', () => {
          if (!lightbox || !lightboxImg) return;
          lightboxImg.src = el.dataset.src ?? '';
          lightboxImg.alt = el.dataset.alt ?? '';
          if (lightboxCaption) lightboxCaption.textContent = el.dataset.caption ?? '';
          lightbox.classList.add('is-open');
          window.verrouillerDefilement?.(true);
        });
      });
      lightbox?.addEventListener('click', (e) => {
        if (e.target === lightbox || (e.target as HTMLElement).hasAttribute('data-lightbox-close')) {
          lightbox.classList.remove('is-open');
          window.verrouillerDefilement?.(false);
        }
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && lightbox?.classList.contains('is-open')) {
          lightbox.classList.remove('is-open');
          window.verrouillerDefilement?.(false);
        }
      });

      // — Barre de progression + bouton retour en haut —
      const progress = document.getElementById('scroll-progress');
      const backToTop = document.getElementById('back-to-top');
      const onScrollUI = () => {
        const h = document.documentElement;
        const scrolled = h.scrollTop / (h.scrollHeight - h.clientHeight || 1);
        if (progress) progress.style.transform = `scaleX(${scrolled})`;
        if (backToTop) {
          const show = h.scrollTop > 500;
          backToTop.classList.toggle('opacity-0', !show);
          backToTop.classList.toggle('translate-y-3', !show);
          backToTop.classList.toggle('pointer-events-none', !show);
        }
      };
      onScrollUI();
      window.addEventListener('scroll', onScrollUI, { passive: true });
      backToTop?.addEventListener('click', () => window.defilerVers?.(0));
    </script>

    {/* Lightbox commune — utilisée par la galerie */}
    <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Photo agrandie">
      <button
        type="button"
        data-lightbox-close
        aria-label="Fermer"
        class="absolute top-6 right-6 text-ivoire/80 hover:text-ivoire transition text-3xl leading-none w-10 h-10 flex items-center justify-center"
      >×</button>
      <figure class="flex flex-col items-center gap-4">
        <img id="lightbox-img" alt="" />
        <figcaption id="lightbox-caption" class="text-ivoire/80 text-sm font-sans tracking-wide"></figcaption>
      </figure>
    </div>
  </body>
</html>
