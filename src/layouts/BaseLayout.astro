---
import '../styles/global.css';
import { site } from '../contenu/site';

interface Props {
  titre?: string;
  description?: string;
}

const { titre = site.seo.titre, description = site.seo.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://duopianccello.fr').toString();
const ogImage = new URL(site.seo.imageOpenGraph, Astro.site ?? 'https://duopianccello.fr').toString();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{titre}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.seo.motsCles.join(', ')} />
    <link rel="canonical" href={canonical} />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.nom} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titre} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Polices Google */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500;600&family=Pinyon+Script&display=swap"
    />

    {/* Favicon SVG line art */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* JSON-LD : structure pour Google (artiste local) */}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'MusicGroup',
      name: site.nom,
      description: site.seo.description,
      genre: 'Musique de chambre',
      url: canonical,
      image: ogImage,
      sameAs: [site.contact.instagramUrl],
      member: [
        { '@type': 'Person', name: 'Claire Bournonville' },
        { '@type': 'Person', name: 'Clémentine Roques' },
      ],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Rambouillet',
        addressRegion: 'Île-de-France',
        addressCountry: 'FR',
      },
      email: site.contact.email,
      telephone: site.contact.telephoneLien,
    })} />
  </head>
  <body>
    <slot />

    {/* Script global : révélations au scroll + lightbox + tracé de traits */}
    <script>
      // — Révélations au scroll —
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              observer.unobserve(e.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
      );
      document.querySelectorAll('.reveal, .trait-anim').forEach((el) => observer.observe(el));

      // Précalcul de la longueur des paths SVG pour le tracé
      document.querySelectorAll('.trait-anim').forEach((svg) => {
        svg.querySelectorAll('path, line, polyline, circle').forEach((p) => {
          try {
            const len = (p as SVGGeometryElement).getTotalLength?.() ?? 1000;
            (p as SVGElement).style.setProperty('--len', String(Math.ceil(len)));
          } catch {}
        });
      });

      // — Lightbox galerie —
      const lightbox = document.getElementById('lightbox');
      const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
      const lightboxCaption = document.getElementById('lightbox-caption');
      document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((el) => {
        el.addEventListener('click', () => {
          if (!lightbox || !lightboxImg) return;
          lightboxImg.src = el.dataset.src ?? '';
          lightboxImg.alt = el.dataset.alt ?? '';
          if (lightboxCaption) lightboxCaption.textContent = el.dataset.caption ?? '';
          lightbox.classList.add('is-open');
          document.body.style.overflow = 'hidden';
        });
      });
      lightbox?.addEventListener('click', (e) => {
        if (e.target === lightbox || (e.target as HTMLElement).hasAttribute('data-lightbox-close')) {
          lightbox.classList.remove('is-open');
          document.body.style.overflow = '';
        }
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          lightbox?.classList.remove('is-open');
          document.body.style.overflow = '';
        }
      });
    </script>

    {/* Lightbox commune — utilisée par la galerie */}
    <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Photo agrandie">
      <button
        type="button"
        data-lightbox-close
        aria-label="Fermer"
        class="absolute top-6 right-6 text-ivoire/80 hover:text-ivoire transition text-3xl leading-none w-10 h-10 flex items-center justify-center"
      >×</button>
      <figure class="flex flex-col items-center gap-4">
        <img id="lightbox-img" alt="" />
        <figcaption id="lightbox-caption" class="text-ivoire/80 text-sm font-sans tracking-wide"></figcaption>
      </figure>
    </div>
  </body>
</html>
