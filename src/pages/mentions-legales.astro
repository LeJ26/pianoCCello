---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { site, legal } from '../contenu/site';

const { editeur, hebergeur } = legal;
const maj = new Date().toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  titre={`Mentions légales — ${site.nom}`}
  description={`Mentions légales du site ${site.nom}.`}
>
  {/* En-tête minimal (sur cette page, on revient simplement à l'accueil) */}
  <header class="border-b border-encre/10">
    <div class="container-prose flex items-center justify-between py-6">
      <a href="/" class="font-script text-2xl sm:text-3xl text-encre hover:text-or transition-colors">
        {site.nom}
      </a>
      <a href="/" class="lien-trait text-sm font-sans tracking-widest2 uppercase text-encre/70 hover:text-encre">
        ← Retour à l'accueil
      </a>
    </div>
  </header>

  <main class="container-prose py-20 sm:py-28">
    <div class="max-w-2xl mx-auto">
      <p class="surtitre">Informations</p>
      <h1 class="titre-section mt-4">Mentions légales</h1>
      <p class="text-sm text-encre/50 font-sans mt-3">Dernière mise à jour : {maj}</p>

      <div class="mt-12 space-y-12">
        {/* Éditeur */}
        <section>
          <h2 class="font-serif text-2xl text-encre mb-3">Éditeur du site</h2>
          <div class="prose-serif text-base space-y-1">
            <p>{editeur.nom}{editeur.statut && ` — ${editeur.statut}`}</p>
            {editeur.adresse && <p>{editeur.adresse}</p>}
            {editeur.siret && <p>SIRET : {editeur.siret}</p>}
            <p>
              Email : <a href={`mailto:${editeur.email}`} class="lien-trait text-or">{editeur.email}</a>
            </p>
            <p>Téléphone : {editeur.telephone}</p>
            <p>Directeur·rice de la publication : {editeur.directeurPublication}</p>
          </div>
        </section>

        {/* Hébergeur */}
        <section>
          <h2 class="font-serif text-2xl text-encre mb-3">Hébergement</h2>
          <div class="prose-serif text-base space-y-1">
            <p>{hebergeur.nom}</p>
            {hebergeur.adresse && <p>{hebergeur.adresse}</p>}
            {hebergeur.site && <p>{hebergeur.site}</p>}
          </div>
        </section>

        {/* Propriété intellectuelle */}
        <section>
          <h2 class="font-serif text-2xl text-encre mb-3">Propriété intellectuelle</h2>
          <p class="prose-serif text-base">
            L'ensemble des contenus présents sur ce site (compositions, textes,
            photographies, illustrations, identité visuelle) est la propriété de
            {' '}{editeur.nom} ou de ses ayants droit, sauf mention contraire. Toute
            reproduction, représentation ou diffusion, totale ou partielle, sans
            autorisation écrite préalable, est interdite.
          </p>
        </section>

        {/* Données personnelles */}
        <section>
          <h2 class="font-serif text-2xl text-encre mb-3">Données personnelles</h2>
          <p class="prose-serif text-base">
            Les informations que vous transmettez via le formulaire de réservation
            (nom, email, date et détails de votre événement) sont utilisées
            uniquement pour répondre à votre demande. Elles ne sont ni vendues ni
            transmises à des tiers à des fins commerciales.
          </p>
          <p class="prose-serif text-base mt-3">
            Conformément au RGPD, vous disposez d'un droit d'accès, de
            rectification et de suppression de vos données : il vous suffit de nous
            écrire à
            {' '}<a href={`mailto:${editeur.email}`} class="lien-trait text-or">{editeur.email}</a>.
          </p>
        </section>

        {/* Cookies */}
        <section>
          <h2 class="font-serif text-2xl text-encre mb-3">Cookies</h2>
          <p class="prose-serif text-base">
            Ce site ne dépose aucun cookie de suivi ni outil de traçage
            publicitaire. Aucune donnée de navigation n'est collectée à votre insu.
          </p>
        </section>

        {/* Achats de partitions */}
        <section>
          <h2 class="font-serif text-2xl text-encre mb-3">Achat de partitions</h2>
          <p class="prose-serif text-base">
            Les partitions sont vendues et livrées via une plateforme de paiement
            externe sécurisée. Le paiement et l'envoi du fichier PDF sont gérés par
            cette plateforme, qui dispose de ses propres conditions de vente.
          </p>
        </section>
      </div>

      <div class="mt-16 pt-8 border-t border-encre/10">
        <a href="/" class="btn-or">← Retour à l'accueil</a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
