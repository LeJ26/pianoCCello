---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Illustration from '../components/Illustration.astro';
import SeparateurPortee from '../components/SeparateurPortee.astro';
import QuiSommesNous from '../components/QuiSommesNous.astro';
import Repertoire from '../components/Repertoire.astro';
import Boutique from '../components/Boutique.astro';
import Galerie from '../components/Galerie.astro';
import Formules from '../components/Formules.astro';
import Reservation from '../components/Reservation.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main id="contenu">
    <Hero />
    <QuiSommesNous />
    <SeparateurPortee />
    <Illustration />
    <Repertoire />
    <Boutique />
    <Galerie />
    <Formules />
    <Reservation />
  </main>
  <Footer />
</BaseLayout>
