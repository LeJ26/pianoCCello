---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Illustration from '../components/Illustration.astro';
import SeparateurClassique from '../components/SeparateurClassique.astro';
import QuiSommesNous from '../components/QuiSommesNous.astro';
import Repertoire from '../components/Repertoire.astro';
import Boutique from '../components/Boutique.astro';
import Galerie from '../components/Galerie.astro';
import Avis from '../components/Avis.astro';
import Presse from '../components/Presse.astro';
import Reservation from '../components/Reservation.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main id="contenu">
    <Hero />
    <QuiSommesNous />
    <SeparateurClassique />
    <Illustration />
    <Repertoire />
    <Boutique />
    <Galerie />
    <Avis />
    <Presse />
    <Reservation />
  </main>
  <Footer />
</BaseLayout>
