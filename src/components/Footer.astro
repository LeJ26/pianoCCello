---
import { site } from '../contenu/site';
const annee = new Date().getFullYear();
---

<footer class="bg-ivoire border-t border-encre/10 py-14">
  <div class="container-prose">
    <div class="flex flex-col md:flex-row gap-10 md:gap-4 items-start md:items-center justify-between">
      <div>
        <p class="font-script text-3xl text-encre">{site.nom}</p>
        <p class="mt-2 text-xs font-sans tracking-widest2 uppercase text-or">{site.baseline}</p>
        <p class="mt-3 text-sm text-encre/60 font-sans">{site.lieu}</p>
      </div>

      <div class="flex flex-wrap gap-x-8 gap-y-2 text-sm font-sans">
        <a href={`mailto:${site.contact.email}`} class="lien-trait text-encre/70 hover:text-encre">
          {site.contact.email}
        </a>
        <a href={`tel:${site.contact.telephoneLien}`} class="lien-trait text-encre/70 hover:text-encre">
          {site.contact.telephone}
        </a>
        <a href={site.contact.instagramUrl} target="_blank" rel="noopener noreferrer" class="lien-trait text-encre/70 hover:text-encre">
          @{site.contact.instagram}
        </a>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-encre/10 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 text-xs text-encre/50 font-sans">
      <p>© {annee} {site.nom}. Tous droits réservés.</p>
      <p>Site réalisé avec soin · Astro & Three.js</p>
    </div>
  </div>
</footer>
