---
import { galerie } from '../contenu/concerts';
---

<section id="galerie" class="relative py-28 sm:py-36 bg-ivoire overflow-hidden">
  <div class="container-prose">
    <div class="text-center reveal max-w-2xl mx-auto">
      <p class="surtitre">En scène</p>
      <h2 class="titre-section mt-4">Galerie de concerts</h2>
      <p class="prose-serif mt-6">
        Passionnées par la musique et la scène, nous nous produisons environ une
        cinquantaine de fois par an depuis fin 2023.
      </p>
    </div>
  </div>

  {/* Carrousel : défile tout seul + flèches + glisser/swipe */}
  <div class="galerie-carrousel relative mt-14 reveal" data-carrousel>
    <div
      class="galerie-track flex gap-4 sm:gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth px-6 sm:px-10"
      data-track
    >
      {galerie.map((src, i) => (
        <div class="galerie-slide snap-start shrink-0 h-[280px] sm:h-[440px]">
          <img
            src={src}
            alt={`Duo pianCCello en concert — photo ${i + 1}`}
            class="h-full w-auto max-w-none object-cover rounded-sm shadow-soft select-none"
            loading={i < 2 ? 'eager' : 'lazy'}
            draggable="false"
          />
        </div>
      ))}
    </div>

    {/* Flèches de navigation */}
    <button
      type="button"
      data-prev
      aria-label="Photo précédente"
      class="galerie-fleche left-2 sm:left-4"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="w-5 h-5"><path d="m15 18-6-6 6-6" /></svg>
    </button>
    <button
      type="button"
      data-next
      aria-label="Photo suivante"
      class="galerie-fleche right-2 sm:right-4"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="w-5 h-5"><path d="m9 18 6-6-6-6" /></svg>
    </button>
  </div>
</section>

<style>
  /* Masquer la barre de défilement (tout en gardant le scroll) */
  .galerie-track {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .galerie-track::-webkit-scrollbar { display: none; }
  .galerie-track.dragging { scroll-behavior: auto; cursor: grabbing; }

  /* Flèches rondes */
  .galerie-fleche {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: rgba(250, 247, 240, 0.9);
    color: #1a1a1a;
    box-shadow: 0 2px 4px rgba(26,26,26,0.06), 0 12px 30px rgba(26,26,26,0.12);
    backdrop-filter: blur(4px);
    transition: background 0.3s ease, transform 0.3s ease;
  }
  .galerie-fleche:hover { background: #b89b5e; color: #faf7f0; }
  .galerie-fleche:active { transform: translateY(-50%) scale(0.94); }

  @media (prefers-reduced-motion: reduce) {
    .galerie-track { scroll-behavior: auto; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carrousel]').forEach((car) => {
    const track = car.querySelector<HTMLElement>('[data-track]');
    const prev = car.querySelector<HTMLElement>('[data-prev]');
    const next = car.querySelector<HTMLElement>('[data-next]');
    if (!track) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pas = () => Math.max(track.clientWidth * 0.8, 250); // distance d'un « clic »

    const avance = (dir: number) => {
      const fin = track.scrollWidth - track.clientWidth - 4;
      if (dir > 0 && track.scrollLeft >= fin) {
        track.scrollTo({ left: 0, behavior: 'smooth' }); // retour au début
      } else if (dir < 0 && track.scrollLeft <= 4) {
        track.scrollTo({ left: track.scrollWidth, behavior: 'smooth' }); // vers la fin
      } else {
        track.scrollBy({ left: dir * pas(), behavior: 'smooth' });
      }
    };

    next?.addEventListener('click', () => { avance(1); relance(); });
    prev?.addEventListener('click', () => { avance(-1); relance(); });

    // Défilement automatique
    let timer: number | undefined;
    const demarre = () => { if (!reduce) timer = window.setInterval(() => avance(1), 4000); };
    const arrete = () => { if (timer) { clearInterval(timer); timer = undefined; } };
    const relance = () => { arrete(); demarre(); };

    car.addEventListener('mouseenter', arrete);
    car.addEventListener('mouseleave', demarre);
    track.addEventListener('touchstart', arrete, { passive: true });

    // Glisser à la souris (desktop) — le tactile utilise le scroll natif
    let down = false, startX = 0, startScroll = 0;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      down = true; startX = e.clientX; startScroll = track.scrollLeft;
      track.classList.add('dragging'); arrete();
    });
    window.addEventListener('pointermove', (e) => {
      if (!down) return;
      track.scrollLeft = startScroll - (e.clientX - startX);
    });
    window.addEventListener('pointerup', () => {
      if (!down) return;
      down = false; track.classList.remove('dragging'); relance();
    });

    demarre();
  });
</script>
