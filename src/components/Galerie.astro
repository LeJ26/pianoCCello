---
import { galerie } from '../contenu/concerts';
import GalerieCarrousel from './GalerieCarrousel.tsx';
---

<section id="galerie" class="relative py-28 sm:py-36 bg-ivoire overflow-hidden">
  <div class="container-prose">
    <div class="text-center reveal max-w-2xl mx-auto">
      <p class="surtitre">En scène</p>
      <h2 class="titre-section mt-4">Galerie de concerts</h2>
      <p class="prose-serif mt-6">
        Passionnées par la musique et la scène, nous nous produisons environ une
        cinquantaine de fois par an depuis fin 2023.
      </p>
    </div>

    {/* Island React chargé seulement quand la galerie approche de l'écran :
        React ne pèse pas sur le premier affichage. */}
    <div class="mt-16 reveal">
      <GalerieCarrousel photos={galerie} client:visible />
    </div>
  </div>
</section>
