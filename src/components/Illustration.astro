---
// Illustration line art du duo (violoncelliste + piano d'un seul trait),
// placée juste sous la bannière. Le fichier est dans public/images/.
// Pour la remplacer, garde le même nom : duo-illustration.png
---

<section class="relative py-20 sm:py-28 bg-ivoire overflow-hidden">
  <div class="container-prose flex flex-col items-center">
    <img
      src="/images/duo-illustration.png"
      alt="Claire & Clémentine — illustration au trait : violoncelle et piano reliés d'une seule ligne"
      width="1050"
      height="600"
      loading="lazy"
      class="reveal w-full max-w-5xl h-auto"
    />
  </div>
</section>
