---
// Section « Claire & Clémentine » : à gauche le dessin au trait avec le texte
// d'invitation posé SOUS les notes (overlay) ; à droite, la photo du duo.
// Les deux colonnes sont de taille égale (50/50) et en grand.
// Le texte se met à l'échelle du dessin (unités cqw) pour rester bien placé.
const invitation =
  'Claire et Clémentine vous invitent pour une promenade musicale à la fois tendre, joyeuse et nostalgique, ponctuée de citations philosophiques et inspirantes.';
---

<section class="relative py-16 sm:py-24 bg-ivoire overflow-hidden">
  <div class="mx-auto w-full max-w-[1600px] px-6 sm:px-8 grid lg:grid-cols-[1.25fr_0.9fr] gap-8 lg:gap-12 items-center">
    {/* Gauche : le dessin + le texte d'invitation sous les notes */}
    <div class="illu-wrap reveal relative w-full">
      <img
        src="/images/duo-illustration.png"
        alt="Claire & Clémentine — illustration au trait : violoncelle et piano reliés d'une seule ligne"
        width="1050"
        height="600"
        loading="lazy"
        class="w-full h-auto"
      />
      <div class="illu-texte absolute" style="left:27%; width:46%; top:67%;">
        <div class="illu-cadre border border-or/40 bg-ivoire/75 shadow-soft">
          <p class="illu-p font-serif italic text-justify text-encre/85">
            {invitation}
          </p>
        </div>
      </div>
    </div>

    {/* Droite : la photo du duo */}
    <div class="reveal zoom-doux" style="--reveal-delay: 150ms">
      <img
        src="/images/duo-photo.jpg"
        alt="Claire et Clémentine, le Duo pianCCello"
        width="1100"
        height="825"
        loading="lazy"
        class="w-full h-auto object-cover shadow-softer"
      />
    </div>
  </div>
</section>

<style>
  .illu-wrap {
    container-type: inline-size;
  }
  .illu-cadre {
    padding: clamp(0.4rem, 1.8cqw, 1.2rem) clamp(0.7rem, 2.5cqw, 1.8rem);
  }
  .illu-p {
    font-size: 1rem; /* repli si cqw non supporté */
    font-size: clamp(0.68rem, 2.5cqw, 1.45rem);
    line-height: 1.4;
  }
</style>
