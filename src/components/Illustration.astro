---
// Section « Claire & Clémentine » : à gauche le dessin au trait (le logo) +
// le texte d'invitation ; à droite, une photo du duo.
// Pour modifier le texte, change la phrase ci-dessous. Pour changer la photo,
// remplace public/images/duo-photo.jpg (garde le même nom).
const invitation =
  'Claire et Clémentine vous invitent pour une promenade musicale à la fois tendre, joyeuse et nostalgique, ponctuée de citations philosophiques et inspirantes.';
---

<section class="relative py-16 sm:py-24 bg-ivoire overflow-hidden">
  <div class="container-prose grid lg:grid-cols-[1.45fr_0.55fr] gap-8 lg:gap-12 items-center">
    {/* Gauche : le dessin + le texte d'invitation */}
    <div class="reveal">
      <img
        src="/images/duo-illustration.png"
        alt="Claire & Clémentine — illustration au trait : violoncelle et piano reliés d'une seule ligne"
        width="1050"
        height="600"
        loading="lazy"
        class="w-full h-auto"
      />
      <div class="mt-4 border border-or/40 bg-ivoire-50/50 px-6 py-6 sm:px-8 sm:py-7 shadow-soft">
        <p class="font-serif italic text-justify text-encre/85 text-lg sm:text-xl leading-relaxed">
          {invitation}
        </p>
      </div>
    </div>

    {/* Droite : la photo du duo */}
    <div class="reveal zoom-doux" style="--reveal-delay: 150ms">
      <img
        src="/images/duo-photo.jpg"
        alt="Claire et Clémentine, le Duo pianCCello"
        width="1100"
        height="825"
        loading="lazy"
        class="w-full h-auto object-cover shadow-softer"
      />
    </div>
  </div>
</section>
