---
import { partitions } from '../contenu/partitions';
import LineArtPartition from './LineArtPartition.astro';
---

<section id="boutique" class="relative py-28 sm:py-36 bg-ivoire-50 border-y border-encre/5">
  <div class="container-prose">
    <div class="text-center reveal max-w-2xl mx-auto">
      <p class="surtitre">Boutique</p>
      <h2 class="titre-section mt-4">Partitions originales</h2>
      <p class="prose-serif mt-6">
        Achetez et téléchargez instantanément les compositions originales du duo,
        au format PDF de haute qualité. Pensé pour les musiciens amateurs comme
        professionnels. Certaines partitions sont arrangées pour piano seul ou
        pour trio. Possibilité d’arrangement à la demande.
      </p>
    </div>

    <div class="mt-16 flex flex-wrap justify-center gap-8">
      {partitions.map((p, i) => {
        const indisponible = p.acheterUrl === 'LIEN_PAIEMENT_A_REMPLIR';
        return (
          <article
            class="carte reveal flex flex-col w-full sm:w-[340px]"
            style={`--reveal-delay: ${i * 100}ms`}
          >
            {/* Visuel de la partition */}
            <div class="group aspect-[4/5] bg-ivoire-200 relative overflow-hidden zoom-doux">
              {p.image ? (
                <img src={p.image} alt={`Partition « ${p.titre} »`} class="w-full h-full object-cover" loading="lazy" />
              ) : (
                <div class="absolute inset-0 flex items-center justify-center p-8 opacity-70 group-hover:opacity-100 transition-opacity duration-500">
                  <LineArtPartition />
                </div>
              )}
              <span class="absolute top-3 left-3 bg-ivoire/90 backdrop-blur text-encre/80 text-[10px] font-sans tracking-widest2 uppercase px-3 py-1">
                {p.instrument}
              </span>
            </div>

            <div class="p-6 flex flex-col gap-3 flex-1">
              <h3 class="font-serif text-2xl text-encre">{p.titre}</h3>
              <p class="text-sm text-encre/70 font-sans leading-relaxed flex-1">{p.description}</p>

              <div class="flex items-center justify-between gap-3 mt-4 pt-4 border-t border-encre/10">
                {p.prix && <span class="font-serif text-2xl text-encre">{p.prix}</span>}
                <a
                  href={indisponible ? '#boutique' : p.acheterUrl}
                  target={indisponible ? undefined : '_blank'}
                  rel={indisponible ? undefined : 'noopener noreferrer'}
                  aria-disabled={indisponible}
                  class={`btn-or text-xs px-5 py-2 ${p.prix ? '' : 'w-full justify-center'} ${indisponible ? 'pointer-events-none opacity-40' : ''}`}
                >
                  {indisponible ? 'Bientôt' : (p.bouton ?? 'Acheter le PDF')}
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    {/* Texte rassurant */}
    <p class="text-center mt-12 text-sm text-encre/60 font-sans reveal">
      <span class="inline-flex items-center gap-2">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
          <path d="M12 22c5-2 9-7 9-13V5l-9-3-9 3v4c0 6 4 11 9 13Z" />
          <path d="m9 12 2 2 4-4" />
        </svg>
        Paiement sécurisé · Téléchargement immédiat du PDF après l'achat
      </span>
    </p>
  </div>
</section>
