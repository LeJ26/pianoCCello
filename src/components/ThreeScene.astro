---
// ════════════════════════════════════════════════════════════════════════
//  SCÈNE 3D — HERO
//
//  Une forme filaire « line art » qui tourne doucement et réagit
//  légèrement à la souris. Volontairement sobre pour rester
//  dans l'esprit noir & blanc / dessin au trait du duo.
//
//  👉 REMPLACER LE MODÈLE 3D ICI :
//  Si tu veux mettre ton propre modèle 3D (.glb), suis ces étapes :
//    1. Mets ton fichier dans `public/models/mon-modele.glb`
//    2. Décommente l'import GLTFLoader dans le script ci-dessous
//    3. Remplace la création de la géométrie filaire par le chargement GLB
//
//  Le composant est isolé pour qu'on puisse le remplacer facilement
//  sans toucher au reste du site.
// ════════════════════════════════════════════════════════════════════════
---

<div class="relative aspect-square w-full max-w-md mx-auto">
  {/* Cercle décoratif derrière la scène 3D */}
  <div
    class="absolute inset-4 rounded-full border border-or/40 pointer-events-none"
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-12 rounded-full border border-encre/10 pointer-events-none"
    aria-hidden="true"
  ></div>

  <canvas
    id="three-canvas"
    class="relative w-full h-full"
    aria-label="Animation 3D décorative — silhouette filaire du duo violoncelle et piano"
  ></canvas>
</div>

<script>
  import * as THREE from 'three';

  const canvas = document.getElementById('three-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const scene = new THREE.Scene();

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      renderer.setSize(rect.width, rect.height, false);
      camera.aspect = rect.width / rect.height;
      camera.updateProjectionMatrix();
    };

    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);
    camera.position.set(0, 0, 5);

    // ══════════════════════════════════════════════════════════════
    // VIOLONCELLE FILAIRE (line art 3D)
    // La silhouette du violoncelle est tracée par des points, lissée,
    // puis légèrement extrudée pour donner du volume. On affiche
    // uniquement les arêtes (edges) pour garder l'esprit « dessin au trait ».
    // À remplacer par un GLTF (voir commentaires en tête du composant).
    // ══════════════════════════════════════════════════════════════

    // Demi-profil droit du violoncelle (de bas en haut), x ≥ 0.
    const demiProfil: [number, number][] = [
      [0.55, -2.15],
      [1.05, -1.78],
      [1.22, -1.30],  // bas du corps (large)
      [1.06, -0.82],
      [0.60, -0.32],  // taille (échancrure en C)
      [0.70, 0.08],
      [1.02, 0.50],   // haut du corps (large)
      [0.90, 0.90],
      [0.42, 1.12],   // épaule
      [0.18, 1.28],   // début du manche
      [0.16, 1.98],   // manche
      [0.24, 2.18],   // chevillier
      [0.16, 2.42],   // volute (simplifiée)
    ];

    // Boucle fermée : bas-centre → côté droit (bas→haut) → haut-centre →
    // côté gauche (miroir, haut→bas) → retour bas-centre.
    const pts: THREE.Vector3[] = [];
    pts.push(new THREE.Vector3(0, -2.32, 0));
    demiProfil.forEach(([x, y]) => pts.push(new THREE.Vector3(x, y, 0)));
    pts.push(new THREE.Vector3(0, 2.5, 0));
    [...demiProfil].reverse().forEach(([x, y]) => pts.push(new THREE.Vector3(-x, y, 0)));

    // Lissage du contour (courbe de Catmull-Rom fermée)
    const courbe = new THREE.CatmullRomCurve3(pts, true, 'catmullrom', 0.5);
    const contour = courbe.getPoints(240).map((p) => new THREE.Vector2(p.x, p.y));
    const forme = new THREE.Shape(contour);

    // Extrusion fine + léger biseau pour donner du relief au trait
    const profondeur = 0.42;
    const corpsGeo = new THREE.ExtrudeGeometry(forme, {
      depth: profondeur,
      bevelEnabled: true,
      bevelThickness: 0.05,
      bevelSize: 0.05,
      bevelSegments: 2,
      curveSegments: 1,
    });
    corpsGeo.translate(0, 0, -profondeur / 2); // centrer en profondeur

    const material = new THREE.LineBasicMaterial({
      color: 0x1a1a1a,
      transparent: true,
      opacity: 0.78,
    });
    const corps = new THREE.LineSegments(new THREE.EdgesGeometry(corpsGeo, 18), material);

    // Groupe qui contient tout le violoncelle (corps + détails)
    const lines = new THREE.Group();
    lines.add(corps);

    const zFront = profondeur / 2 + 0.07; // face avant, pour poser les détails

    // — Cordes (4 lignes dorées, du chevillier au cordier) —
    const corPositions: number[] = [];
    const xCordes = [-0.18, -0.06, 0.06, 0.18];
    xCordes.forEach((x) => {
      corPositions.push(x, 2.05, zFront, x * 0.42, -1.75, zFront);
    });
    const cordesGeo = new THREE.BufferGeometry();
    cordesGeo.setAttribute('position', new THREE.Float32BufferAttribute(corPositions, 3));
    const cordesMat = new THREE.LineBasicMaterial({ color: 0xb89b5e, transparent: true, opacity: 0.85 });
    lines.add(new THREE.LineSegments(cordesGeo, cordesMat));

    // — Chevalet + cordier (petits traits) —
    const detailPos = [
      -0.28, -0.55, zFront, 0.28, -0.55, zFront, // chevalet
      0, -1.7, zFront, -0.16, -2.0, zFront,       // cordier (V)
      0, -1.7, zFront, 0.16, -2.0, zFront,
    ];
    const detailGeo = new THREE.BufferGeometry();
    detailGeo.setAttribute('position', new THREE.Float32BufferAttribute(detailPos, 3));
    lines.add(new THREE.LineSegments(detailGeo, material));

    // — Ouïes (deux « f » stylisés de part et d'autre du chevalet) —
    const ouie = (signe: number) => {
      const courbeOuie = new THREE.CubicBezierCurve3(
        new THREE.Vector3(signe * 0.42, 0.15, zFront),
        new THREE.Vector3(signe * 0.30, -0.1, zFront),
        new THREE.Vector3(signe * 0.52, -0.5, zFront),
        new THREE.Vector3(signe * 0.40, -0.85, zFront)
      );
      const geo = new THREE.BufferGeometry().setFromPoints(courbeOuie.getPoints(24));
      lines.add(new THREE.Line(geo, material));
    };
    ouie(1);
    ouie(-1);

    // Mise à l'échelle et centrage vertical du violoncelle entier
    lines.scale.setScalar(0.66);
    lines.position.y = -0.06;
    scene.add(lines);

    // Petites particules dorées en arrière-plan (poussière musicale)
    const particleGeo = new THREE.BufferGeometry();
    const N = 80;
    const positions = new Float32Array(N * 3);
    for (let i = 0; i < N; i++) {
      positions[i * 3] = (Math.random() - 0.5) * 6;
      positions[i * 3 + 1] = (Math.random() - 0.5) * 6;
      positions[i * 3 + 2] = (Math.random() - 0.5) * 4 - 1;
    }
    particleGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    const particleMat = new THREE.PointsMaterial({
      color: 0xb89b5e,
      size: 0.025,
      transparent: true,
      opacity: 0.6,
    });
    const particles = new THREE.Points(particleGeo, particleMat);
    scene.add(particles);

    // Réaction à la souris (légère parallaxe)
    const target = { x: 0, y: 0 };
    const current = { x: 0, y: 0 };
    window.addEventListener('pointermove', (e) => {
      const rect = canvas.getBoundingClientRect();
      const x = (e.clientX - rect.left - rect.width / 2) / rect.width;
      const y = (e.clientY - rect.top - rect.height / 2) / rect.height;
      target.x = x;
      target.y = y;
    });

    let raf = 0;
    let running = true;
    const clock = new THREE.Clock();
    const tick = () => {
      const t = clock.getElapsedTime();
      current.x += (target.x - current.x) * 0.05;
      current.y += (target.y - current.y) * 0.05;
      if (reducedMotion) {
        lines.rotation.set(0.05, 0.25, 0);
      } else {
        // Oscillation douce : le violoncelle reste de face et « respire »
        lines.rotation.y = current.x * 0.5 + Math.sin(t * 0.32) * 0.45;
        lines.rotation.x = current.y * 0.28 + Math.sin(t * 0.24) * 0.04;
        lines.position.y = -0.06 + Math.sin(t * 0.5) * 0.04; // léger flottement
        particles.rotation.y = t * 0.04;
      }
      renderer.render(scene, camera);
      if (running) raf = requestAnimationFrame(tick);
    };

    // Ne tourner que quand visible — économie batterie + perf
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          running = e.isIntersecting;
          if (running && !raf) {
            clock.start();
            raf = requestAnimationFrame(tick);
          } else if (!running && raf) {
            cancelAnimationFrame(raf);
            raf = 0;
          }
        });
      },
      { threshold: 0.05 }
    );
    io.observe(canvas);

    resize();
    new ResizeObserver(resize).observe(canvas);
    raf = requestAnimationFrame(tick);
  }
</script>
