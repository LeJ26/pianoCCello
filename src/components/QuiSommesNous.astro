---
import { artistes } from '../contenu/site';
---

<section id="qui" class="relative py-28 sm:py-36 bg-ivoire">
  <div class="container-prose">
    <div class="text-center reveal">
      <p class="surtitre">Le duo</p>
      <h2 class="titre-section mt-4">Qui sommes-nous&nbsp;?</h2>
    </div>

    {/* Une ligne par artiste : photo à gauche, texte à droite */}
    <div class="mt-12 sm:mt-14 space-y-10 sm:space-y-14">
      {artistes.map((a) => (
        <article class="reveal grid md:grid-cols-[0.85fr_1.15fr] gap-8 lg:gap-14 items-center">
          {/* Photo à gauche */}
          <div class="zoom-doux relative">
            <img
              src={a.photo}
              alt={`Portrait de ${a.prenom} ${a.nom}`}
              width="800"
              height="1000"
              loading="lazy"
              class="w-full aspect-[4/5] object-cover object-top shadow-softer"
            />
            <div class="absolute -bottom-4 -left-4 h-20 w-20 border border-or/60 pointer-events-none"></div>
          </div>

          {/* Texte à droite */}
          <div>
            <h3 class="font-daydream text-4xl sm:text-5xl text-encre leading-tight">
              {a.prenom} {a.nom}
            </h3>
            <span class="block text-or font-sans text-xs tracking-widest2 uppercase mt-2">{a.role}</span>
            <p class="prose-serif mt-5">{a.bio}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
