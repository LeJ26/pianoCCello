---
import { artistes } from '../contenu/site';
---

<section id="qui" class="relative py-28 sm:py-36 bg-ivoire">
  <div class="container-prose">
    <div class="text-center reveal">
      <p class="surtitre">Le duo</p>
      <h2 class="titre-section mt-4">Qui sommes-nous&nbsp;?</h2>
    </div>

    <div class="mt-16 grid lg:grid-cols-[1.1fr_1fr] gap-12 lg:gap-20 items-center">
      {/* Portrait du duo */}
      <div class="reveal zoom-doux">
        <div class="relative">
          <img
            src="/images/duo-portrait-2025-10-11.jpg"
            alt={`Portrait de ${artistes[0].prenom} ${artistes[0].nom} et ${artistes[1].prenom} ${artistes[1].nom}`}
            class="w-full h-auto object-cover shadow-softer"
            loading="lazy"
          />
          <div class="absolute -bottom-4 -left-4 h-24 w-24 border border-or/60 pointer-events-none"></div>
          <div class="absolute -top-4 -right-4 h-24 w-24 border border-or/60 pointer-events-none"></div>
        </div>
      </div>

      {/* Bios */}
      <div class="space-y-12">
        {artistes.map((a, i) => (
          <article class="reveal" style={`--reveal-delay: ${i * 150}ms`}>
            <h3 class="font-serif text-3xl sm:text-4xl text-encre leading-tight">
              {a.prenom} {a.nom}
            </h3>
            <span class="block text-or font-sans text-xs tracking-widest2 uppercase mt-2">{a.role}</span>
            <p class="prose-serif mt-4">{a.bio}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
