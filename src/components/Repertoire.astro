---
import { repertoire } from '../contenu/site';

const { creations, recueils, videos, audios } = repertoire;
---

<section id="repertoire" class="relative py-28 sm:py-36 bg-ivoire-50 border-y border-encre/5 overflow-hidden">
  {/* Clé de sol line art en filigrane décoratif */}
  <svg
    viewBox="0 0 100 240"
    fill="none"
    stroke="#B89B5E"
    stroke-width="1.2"
    stroke-linecap="round"
    class="absolute -right-6 top-1/2 -translate-y-1/2 -scale-x-100 h-[120%] opacity-10 pointer-events-none"
    aria-hidden="true"
  >
    <path d="M52 10 C 30 30, 30 70, 50 90 C 75 115, 78 160, 55 185 C 38 203, 18 195, 18 172 C 18 155, 35 150, 45 162 C 52 170, 48 182, 38 182 M52 10 C 70 25, 72 55, 55 90 L 45 200 C 42 220, 28 225, 22 215" />
  </svg>

  <div class="container-prose relative">
    <div class="text-center reveal max-w-2xl mx-auto">
      <p class="surtitre">Au programme</p>
      <h2 class="titre-section mt-4">Notre répertoire</h2>
      <p class="prose-serif mt-6 text-base whitespace-pre-line">{creations.texte}</p>
    </div>

    {/* Les 6 recueils */}
    <div class="mt-14 sm:mt-16 grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {recueils.map((r, i) => {
        const fond = (r as { fond?: string }).fond;
        const style = fond
          ? `--reveal-delay: ${i * 90}ms; background-image: linear-gradient(rgba(250,247,240,0.86), rgba(250,247,240,0.92)), url('${fond}'); background-size: cover; background-position: center;`
          : `--reveal-delay: ${i * 90}ms`;
        return (
          <article class="carte reveal p-6 sm:p-7 flex flex-col" style={style}>
            <h3 class="font-serif text-2xl text-encre flex items-center gap-2.5 pb-3 border-b border-encre/10">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-or shrink-0" aria-hidden="true">
                <circle cx="8" cy="18" r="4" />
                <path d="M12 18V2l7 4" />
              </svg>
              {r.titre}
            </h3>
            <ul class="mt-4 space-y-1.5 font-serif text-encre/75">
              {r.pieces.map((p) => (
                <li class="flex items-start gap-2.5 leading-snug">
                  <span class="h-px w-3 bg-or shrink-0 mt-2.5"></span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </article>
        );
      })}
    </div>

    {/* Suite du texte d'introduction, placée après les recueils : le conte
        musical et les arrangements de Noël se comprennent mieux une fois
        les recueils parcourus. */}
    {creations.complement && (
      <p class="reveal mt-14 sm:mt-16 prose-serif text-base text-center max-w-2xl mx-auto whitespace-pre-line">
        {creations.complement}
      </p>
    )}

    {/* Vidéos YouTube */}
    {videos && videos.length > 0 && (
      <div class="mt-20 sm:mt-24">
        <p class="surtitre text-center">À écouter</p>
        <div class="mt-8 grid md:grid-cols-2 gap-6 lg:gap-10 max-w-4xl mx-auto">
          {videos.map((v) => (
            <figure class="reveal">
              <div class="aspect-video overflow-hidden rounded-sm shadow-soft bg-encre/5">
                <iframe
                  class="w-full h-full"
                  src={`https://www.youtube-nocookie.com/embed/${v.id}`}
                  title={`Duo pianCCello — ${v.titre}`}
                  loading="lazy"
                  allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen
                ></iframe>
              </div>
              <figcaption class="mt-3 text-center font-serif italic text-encre/70">{v.titre}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    )}

    {/* Extraits audio (lecteur sur-mesure : lecture/pause + barre) */}
    {audios && audios.length > 0 && (
      <div class="mt-16 sm:mt-20">
        <p class="surtitre text-center">Extraits audio</p>
        <div class="mt-8 max-w-2xl mx-auto space-y-4">
          {audios.map((a) => (
            <div class="carte reveal flex items-center gap-4 p-4 sm:p-5" data-audio>
              <button
                type="button"
                data-play
                aria-label={`Écouter ${a.titre}`}
                class="w-12 h-12 rounded-full border border-or/60 flex items-center justify-center text-or hover:bg-or hover:text-ivoire transition-colors duration-300 shrink-0"
              >
                <svg data-icon-play viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 ml-0.5"><path d="M8 5v14l11-7z" /></svg>
                <svg data-icon-pause viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 hidden"><path d="M6 5h3v14H6zM15 5h3v14h-3z" /></svg>
              </button>
              <div class="flex-1 min-w-0">
                <p class="font-serif text-lg text-encre">{a.titre}</p>
                <div data-track class="mt-2.5 h-1.5 bg-encre/10 rounded-full cursor-pointer overflow-hidden">
                  <div data-fill class="h-full bg-or rounded-full" style="width:0%"></div>
                </div>
              </div>
              <audio data-el src={a.fichier} preload="none"></audio>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-audio]').forEach((p) => {
    const audio = p.querySelector('audio');
    const btn = p.querySelector('[data-play]');
    const iconPlay = p.querySelector('[data-icon-play]');
    const iconPause = p.querySelector('[data-icon-pause]');
    const track = p.querySelector<HTMLElement>('[data-track]');
    const fill = p.querySelector<HTMLElement>('[data-fill]');
    if (!audio || !btn || !track || !fill) return;

    const setPlaying = (on: boolean) => {
      iconPlay?.classList.toggle('hidden', on);
      iconPause?.classList.toggle('hidden', !on);
    };

    btn.addEventListener('click', () => {
      if (audio.paused) {
        document.querySelectorAll('audio').forEach((o) => { if (o !== audio) o.pause(); });
        audio.play();
      } else {
        audio.pause();
      }
    });
    audio.addEventListener('play', () => setPlaying(true));
    audio.addEventListener('pause', () => setPlaying(false));
    audio.addEventListener('ended', () => { setPlaying(false); fill.style.width = '0%'; });
    audio.addEventListener('timeupdate', () => {
      if (audio.duration) fill.style.width = (audio.currentTime / audio.duration) * 100 + '%';
    });
    track.addEventListener('click', (e) => {
      const rect = track.getBoundingClientRect();
      const ratio = Math.min(Math.max((e.clientX - rect.left) / rect.width, 0), 1);
      if (audio.duration) audio.currentTime = ratio * audio.duration;
    });
  });
</script>
