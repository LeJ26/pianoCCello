---
import { repertoire } from '../contenu/site';

const { creations, recueils } = repertoire;
---

<section id="repertoire" class="relative py-28 sm:py-36 bg-ivoire-50 border-y border-encre/5 overflow-hidden">
  {/* Clé de sol line art en filigrane décoratif */}
  <svg
    viewBox="0 0 100 240"
    fill="none"
    stroke="#B89B5E"
    stroke-width="1.2"
    stroke-linecap="round"
    class="absolute -right-6 top-1/2 -translate-y-1/2 h-[120%] opacity-10 pointer-events-none"
    aria-hidden="true"
  >
    <path d="M52 10 C 30 30, 30 70, 50 90 C 75 115, 78 160, 55 185 C 38 203, 18 195, 18 172 C 18 155, 35 150, 45 162 C 52 170, 48 182, 38 182 M52 10 C 70 25, 72 55, 55 90 L 45 200 C 42 220, 28 225, 22 215" />
  </svg>

  <div class="container-prose relative">
    <div class="text-center reveal max-w-2xl mx-auto">
      <p class="surtitre">Au programme</p>
      <h2 class="titre-section mt-4">Notre répertoire</h2>
      <p class="prose-serif mt-6 text-base whitespace-pre-line">{creations.texte}</p>
    </div>

    {/* Les 6 recueils */}
    <div class="mt-14 sm:mt-16 grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {recueils.map((r, i) => (
        <article class="carte reveal p-6 sm:p-7 flex flex-col" style={`--reveal-delay: ${i * 90}ms`}>
          <h3 class="font-serif text-2xl text-encre flex items-center gap-2.5 pb-3 border-b border-encre/10">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-or shrink-0" aria-hidden="true">
              <circle cx="8" cy="18" r="4" />
              <path d="M12 18V2l7 4" />
            </svg>
            {r.titre}
          </h3>
          <ul class="mt-4 space-y-1.5 font-serif text-encre/75">
            {r.pieces.map((p) => (
              <li class="flex items-start gap-2.5 leading-snug">
                <span class="h-px w-3 bg-or shrink-0 mt-2.5"></span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
