---
// Séparateur classique : un fin trait qui traverse, avec un petit losange
// doré au centre. Sobre, sans animation.
// Pour l'allonger/le raccourcir, change `max-w-3xl` ci-dessous.
---

<div class="container-prose py-12 sm:py-16">
  <div class="mx-auto max-w-3xl flex items-center gap-5" aria-hidden="true">
    <span
      class="h-px flex-1"
      style="background: linear-gradient(to right, transparent, rgba(26,26,26,0.18) 22%, rgba(184,155,94,0.6));"
    ></span>
    <span class="block w-2 h-2 rotate-45 border border-or/80"></span>
    <span
      class="h-px flex-1"
      style="background: linear-gradient(to left, transparent, rgba(26,26,26,0.18) 22%, rgba(184,155,94,0.6));"
    ></span>
  </div>
</div>
