---
import { site } from '../contenu/site';
import ThreeScene from './ThreeScene.astro';

// Images du fond défilant (dans public/images/). Pour les remplacer,
// garde les mêmes noms ou modifie la liste ci-dessous.
const fond = ['/images/hero-cello.jpg', '/images/hero-piano.jpg'];
// On répète la séquence 4 fois pour un défilement sans couture.
const bande = [...fond, ...fond, ...fond, ...fond];
---

<section id="hero" class="relative min-h-screen flex flex-col items-center justify-center text-center overflow-hidden pt-28 pb-24">
  {/* Fond : photos qui défilent à l'infini + voile ivoire pour la lisibilité */}
  <div class="hero-bg absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
    <div class="hero-track flex h-full">
      {bande.map((src) => (
        <img src={src} alt="" class="hero-img h-full w-auto max-w-none object-cover shrink-0" />
      ))}
    </div>
    <div class="hero-veil absolute inset-0"></div>
  </div>

  <div class="container-prose relative z-10">
    {/* Deux colonnes à partir de 1024 px : le duo à gauche, la scène 3D à
        droite. En dessous, la scène est masquée et la mise en page reste
        centrée comme auparavant. */}
    <div class="grid lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] gap-10 xl:gap-16 items-center">
      {/* L'apparition est pilotée par la timeline GSAP (src/scripts/animations.ts) */}
      <div class="flex flex-col items-center lg:items-start lg:text-left">
        {/* Logo officiel du duo (calligraphie Daydream) — occupe toute la bannière.
            Le fichier est dans public/images/. Pour le remplacer, garde le même nom. */}
        <h1 class="w-full max-w-3xl lg:max-w-none">
          <img
            src="/images/logo-duo-pianccello.png"
            alt={`${site.nom} — ${site.baseline}`}
            width="1050"
            height="600"
            fetchpriority="high"
            class="w-full h-auto"
          />
        </h1>

        <p class="mt-8 prose-serif italic max-w-3xl text-xl sm:text-2xl lg:text-3xl">
          {site.accroche}
        </p>
        <div class="mt-10 flex flex-wrap justify-center lg:justify-start gap-4">
          <a href="#reserver" class="btn-encre">Réserver un concert</a>
          <a href="#boutique" class="btn-or">Découvrir les partitions</a>
        </div>
      </div>

      {/* Scène 3D : piano et violoncelle dessinés au trait */}
      <div class="hidden lg:block">
        <ThreeScene />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-track {
    width: max-content;
    animation: hero-scroll 60s linear infinite;
    will-change: transform;
  }
  .hero-img {
    filter: blur(2px);
  }
  /* On défile d'un quart (la bande contient 4 copies) → boucle sans couture */
  @keyframes hero-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-25%); }
  }
  /* Voile ivoire : opaque au centre (lisibilité), plus léger sur les bords */
  .hero-veil {
    background: radial-gradient(
      ellipse at center,
      rgba(250, 247, 240, 0.88) 0%,
      rgba(250, 247, 240, 0.7) 55%,
      rgba(250, 247, 240, 0.55) 100%
    );
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-track { animation: none; }
  }
</style>
