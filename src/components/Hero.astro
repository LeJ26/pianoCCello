---
import { site } from '../contenu/site';
---

<section id="hero" class="relative min-h-screen flex flex-col items-center justify-center text-center overflow-hidden pt-28 pb-24">
  <div class="container-prose relative">
    <div class="reveal flex flex-col items-center">
      <p class="surtitre mb-8">{site.lieu}</p>

      {/* Logo officiel du duo (calligraphie Daydream) — occupe toute la bannière.
          Le fichier est dans public/images/. Pour le remplacer, garde le même nom. */}
      <h1 class="w-full max-w-4xl">
        <img
          src="/images/logo-duo-pianccello.png"
          alt={`${site.nom} — ${site.baseline}`}
          width="1050"
          height="600"
          fetchpriority="high"
          class="w-full h-auto"
        />
      </h1>

      <p class="mt-8 prose-serif italic max-w-2xl mx-auto">
        {site.accroche}
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="#reserver" class="btn-encre">Réserver un concert</a>
        <a href="#boutique" class="btn-or">Découvrir les partitions</a>
      </div>
    </div>
  </div>
</section>
