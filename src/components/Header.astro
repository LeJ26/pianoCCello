---
import { site } from '../contenu/site';

// Liens de navigation — ajoute/retire une entrée ici si besoin.
const liens = [
  { href: '#qui', label: 'Le duo' },
  { href: '#repertoire', label: 'Répertoire' },
  { href: '#boutique', label: 'Partitions' },
  { href: '#galerie', label: 'Galerie' },
  { href: '#formules', label: 'Tarifs' },
  { href: '#reserver', label: 'Nous engager' },
];
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-40 transition-all duration-500 ease-soft"
>
  <div class="container-prose flex items-center justify-between py-5 sm:py-6">
    <a href="#hero" class="group relative z-50" aria-label={`${site.nom} — accueil`}>
      <span class="font-script text-2xl sm:text-3xl text-encre leading-none transition-colors group-hover:text-or">
        {site.nom}
      </span>
    </a>

    {/* Navigation desktop */}
    <nav aria-label="Navigation principale" class="hidden md:flex items-center gap-5 lg:gap-7 text-xs lg:text-sm font-sans tracking-widest2 uppercase">
      {liens.map((l) => (
        <a href={l.href} class="lien-trait text-encre/80 hover:text-encre">{l.label}</a>
      ))}
    </nav>

    <a href="#reserver" class="hidden md:inline-flex btn-or text-xs px-5 py-2">Réserver</a>

    {/* Bouton menu mobile (hamburger) */}
    <button
      id="menu-toggle"
      type="button"
      class="md:hidden relative z-50 w-10 h-10 flex flex-col items-center justify-center gap-1.5"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="menu-mobile"
    >
      <span class="block h-px w-7 bg-encre transition-all duration-300 ease-soft origin-center" data-bar="1"></span>
      <span class="block h-px w-7 bg-encre transition-all duration-300 ease-soft" data-bar="2"></span>
      <span class="block h-px w-7 bg-encre transition-all duration-300 ease-soft origin-center" data-bar="3"></span>
    </button>
  </div>

  {/* Menu mobile plein écran */}
  <div
    id="menu-mobile"
    class="md:hidden fixed inset-0 z-40 bg-ivoire/98 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-500 ease-soft flex flex-col items-center justify-center gap-8"
  >
    <nav aria-label="Navigation mobile" class="flex flex-col items-center gap-7 text-center">
      {liens.map((l, i) => (
        <a
          href={l.href}
          class="menu-mobile-lien font-serif text-4xl text-encre hover:text-or transition-colors duration-300"
          style={`--i: ${i}`}
        >
          {l.label}
        </a>
      ))}
    </nav>
    <a href="#reserver" class="menu-mobile-lien btn-or mt-4" style="--i: 5">Réserver un concert</a>
  </div>
</header>

<style>
  /* Header : fond ivoire + ombre qui apparaissent quand on a scrollé */
  #site-header.scrolled {
    @apply bg-ivoire/90 backdrop-blur-md shadow-soft;
  }
  #site-header.scrolled :global(.btn-or) {
    @apply py-2;
  }

  /* Hamburger -> croix quand le menu est ouvert */
  #menu-toggle.is-open [data-bar="1"] {
    transform: translateY(6.5px) rotate(45deg);
  }
  #menu-toggle.is-open [data-bar="2"] {
    opacity: 0;
    transform: scaleX(0);
  }
  #menu-toggle.is-open [data-bar="3"] {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* Apparition en cascade des liens du menu mobile */
  #menu-mobile.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .menu-mobile-lien {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 400ms ease, transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i) * 60ms);
  }
  #menu-mobile.is-open .menu-mobile-lien {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-mobile-lien { transition: opacity 0.01ms; transform: none; }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-mobile');

  // Fond du header au scroll
  const onScroll = () => {
    if (window.scrollY > 40) header?.classList.add('scrolled');
    else header?.classList.remove('scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Ouverture / fermeture du menu mobile
  const closeMenu = () => {
    toggle?.classList.remove('is-open');
    menu?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Ouvrir le menu');
    document.body.style.overflow = '';
  };
  const openMenu = () => {
    toggle?.classList.add('is-open');
    menu?.classList.add('is-open');
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.setAttribute('aria-label', 'Fermer le menu');
    document.body.style.overflow = 'hidden';
  };
  toggle?.addEventListener('click', () => {
    if (menu?.classList.contains('is-open')) closeMenu();
    else openMenu();
  });
  // Fermer le menu après un clic sur un lien
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>
